<?xml version="1.0" encoding="utf-8"?>
<!-- «يوم الأسبوع»: the weekday in calligraphy (res/drawable-nodpi/day_0..6, Sunday first: white lettering cut from the owner's art of 16 Nov 2026, no background)
     over a night-blue ground whose opacity the user chooses, with the date under it (DayWidget). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dRoot" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/dBg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/widget_day_bg" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/dImg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:padding="4dp" android:scaleType="fitCenter" android:src="@drawable/day_5" android:contentDescription="@string/day_widget_name" />
    <TextView android:id="@+id/dDate" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="7dp"
        android:text="5 جمادى الآخرة 1448 هـ · 15 نوفمبر 2026" android:textSize="12sp" android:maxLines="1"
        android:textColor="#F2EEDC" android:shadowColor="#000000" android:shadowRadius="5" />
    <TextView android:id="@+id/dLock" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="6dp" android:gravity="center"
        android:paddingLeft="10dp" android:paddingRight="10dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:visibility="gone"
        android:background="@drawable/clock_chip" android:text="@string/widget_locked_short" android:textSize="12sp" android:textStyle="bold"
        android:maxLines="1" android:textColor="#0B1F5C" />
</FrameLayout>
