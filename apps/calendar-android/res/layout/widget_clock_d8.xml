                android:textColor="#FFFFFF" android:includeFontPadding="false" android:textDirection="ltr" android:maxLines="1"
                android:layout_marginTop="-46.9dp" android:layout_marginBottom="-44.7dp" android:shadowColor="#80000000" android:shadowRadius="6"  />
            <ImageView android:layout_width="2dp" android:layout_height="56dp" android:background="#E6BC62" android:importantForAccessibility="no" android:layout_marginLeft="7dp" android:layout_marginRight="7dp" />
            <TextClock android:id="@+id/cMin" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:format24Hour="mm" android:format12Hour="mm" android:fontFamily="@font/clk_saira" android:textSize="57.5dp"
                android:textColor="#E6BC62" android:includeFontPadding="false" android:textDirection="ltr" android:maxLines="1"
                android:layout_marginTop="-24.2dp" android:layout_marginBottom="-23.5dp" android:shadowColor="#80000000" android:shadowRadius="6"  />
        </LinearLayout>
        <TextView android:id="@+id/cNext" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:text="القادمة: العشاء 19:47" android:textSize="12sp" android:maxLines="1"
            android:textColor="#B9C2E8" android:shadowColor="#80000000" android:shadowRadius="4" />
    </LinearLayout>
    <TextView android:id="@+id/cLock" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center" android:gravity="center" android:padding="10dp" android:visibility="gone"
        android:text="@string/clock_widget_locked" android:textSize="14sp" android:textStyle="bold" android:maxLines="2"
        android:textColor="#F6DFA0" android:shadowColor="#000000" android:shadowRadius="5" />
</FrameLayout>
