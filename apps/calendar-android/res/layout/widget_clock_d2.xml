<?xml version="1.0" encoding="utf-8"?>
<!-- «الساعة», model الأعمدة: generated by tools/clock-models.py -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cRoot" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/cBg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/widget_day_bg" android:importantForAccessibility="no" />
    <LinearLayout android:id="@+id/cBody" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="center" android:padding="8dp">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal"
            android:layoutDirection="ltr" android:gravity="center_vertical" android:baselineAligned="false">
            <TextClock android:id="@+id/cTime" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:format24Hour="HH" android:format12Hour="HH" android:textSize="86sp" android:fontFamily="sans-serif-condensed"
                android:textColor="#FFFFFF" android:textScaleX="0.68" android:includeFontPadding="false" android:textDirection="ltr"
                android:shadowColor="#80000000" android:shadowRadius="6" android:textStyle="bold" android:layout_marginTop="-16dp" android:layout_marginBottom="-17dp" />
            <ImageView android:layout_width="2dp" android:layout_height="58dp" android:background="#E6BC62" android:importantForAccessibility="no" android:layout_marginLeft="7dp" android:layout_marginRight="7dp" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical"
                android:gravity="left">
                <TextClock android:id="@+id/cMin" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:format24Hour="mm" android:format12Hour="mm" android:textSize="44sp" android:fontFamily="sans-serif-condensed"
                    android:textColor="#E6BC62" android:textScaleX="0.7" android:includeFontPadding="false" android:textDirection="ltr"
                    android:shadowColor="#80000000" android:shadowRadius="6"  android:layout_marginTop="-8dp" android:layout_marginBottom="-9dp" />
                <TextClock android:id="@+id/cSec" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:format24Hour="ss" android:format12Hour="ss" android:textSize="18sp" android:fontFamily="sans-serif-condensed-light"
                    android:textColor="#B9C2E8" android:textScaleX="0.8" android:includeFontPadding="false" android:textDirection="ltr"
                    android:shadowColor="#80000000" android:shadowRadius="6"  />
            </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/cNext" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:text="القادمة: العشاء 19:47" android:textSize="12sp" android:maxLines="1"
            android:textColor="#B9C2E8" android:shadowColor="#80000000" android:shadowRadius="4" />
    </LinearLayout>
    <TextView android:id="@+id/cLock" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center" android:gravity="center" android:padding="10dp" android:visibility="gone"
        android:text="@string/clock_widget_locked" android:textSize="14sp" android:textStyle="bold" android:maxLines="2"
        android:textColor="#F6DFA0" android:shadowColor="#000000" android:shadowRadius="5" />
</FrameLayout>
