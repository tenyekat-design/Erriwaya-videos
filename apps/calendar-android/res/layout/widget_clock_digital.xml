<?xml version="1.0" encoding="utf-8"?>
<!-- «الساعة» (digital): the time large, the Hijri and Gregorian date, and the next prayer, over the widgets' night-blue
     ground. TextClock keeps the time itself; ClockWidget fills in the rest. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cRoot" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/cBg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/widget_day_bg" android:importantForAccessibility="no" />
    <LinearLayout android:id="@+id/cBody" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="center" android:layoutDirection="rtl" android:padding="8dp">
        <TextClock android:id="@+id/cTime" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:format24Hour="HH:mm" android:format12Hour="HH:mm" android:textSize="58sp" android:fontFamily="sans-serif-thin"
            android:textColor="#FFFFFF" android:includeFontPadding="false" android:textDirection="ltr"
            android:shadowColor="#80000000" android:shadowRadius="6" />
        <TextView android:id="@+id/cHijri" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="5 جمادى الآخرة 1448 هـ" android:textSize="14sp" android:textStyle="bold" android:maxLines="1"
            android:textColor="#E6BC62" android:shadowColor="#80000000" android:shadowRadius="4" />
        <TextView android:id="@+id/cGreg" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="الأحد 15 نوفمبر 2026" android:textSize="12sp" android:maxLines="1"
            android:textColor="#F2EEDC" android:shadowColor="#80000000" android:shadowRadius="4" />
        <TextView android:id="@+id/cNext" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="3dp" android:text="القادمة: العشاء 19:47" android:textSize="12sp" android:maxLines="1"
            android:textColor="#B9C2E8" android:shadowColor="#80000000" android:shadowRadius="4" />
    </LinearLayout>
    <TextView android:id="@+id/cLock" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center" android:gravity="center" android:padding="10dp" android:visibility="gone"
        android:text="@string/clock_widget_locked" android:textSize="14sp" android:textStyle="bold" android:maxLines="2"
        android:textColor="#F6DFA0" android:shadowColor="#000000" android:shadowRadius="5" />
</FrameLayout>
