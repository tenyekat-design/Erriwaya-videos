    // ── الاشتراكات والتفعيل التلقائي (تطبيق التقويم الموريتاني) ──
    // تُلصق هذه الكتلة داخل: match /databases/{database}/documents { ... } بجانب القواعد الحالية (مثل كتلة اقتراحات القرى).
    //
    // sub_requests/<رقم الجهاز>: طلب تفعيل يرسله المشترك بعد الدفع؛ يكتبه أي تطبيق، ولا يقرؤه ولا يغيّر حالته ولا يحذفه إلا المشرف.
    match /sub_requests/{id} {
      allow create, update: if id.matches('^[A-Z2-7]{10}$')
        && request.resource.data.keys().hasOnly(['id', 'app', 'phone', 'ref', 'status', 't', 'plan'])
        && request.resource.data.get('plan', 'one') in ['one', 'family']
        && request.resource.data.keys().hasAll(['id', 'app', 'phone', 'status', 't'])
        && request.resource.data.id == id
        && request.resource.data.status == 'new'
        && request.resource.data.app in ['bankily', 'masrvi', 'sedad', 'bim']
        && request.resource.data.phone is string && request.resource.data.phone.matches('^[0-9]{8,15}$')
        && request.resource.data.get('ref', '') is string && request.resource.data.get('ref', '').size() <= 40
        && request.resource.data.t == request.time;
      allow update: if request.auth != null && request.auth.token.email == 'tenyekat@gmail.com'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow read, delete: if request.auth != null && request.auth.token.email == 'tenyekat@gmail.com';
    }
    // sub_family/<رقم جهاز الدافع>: أجهزة العائلة التي يضيفها المشترك العائلي (حتى 4)؛ يكتبها أي تطبيق، وهاتف الناشر يتحقق
    // من أن الدافع مشترك عائلي ويعطي كل جهاز رمزه، ولا يقرؤها إلا المشرف.
    match /sub_family/{id} {
      allow create, update: if id.matches('^[A-Z2-7]{10}$')
        && request.resource.data.keys().hasOnly(['members', 'status', 't'])
        && request.resource.data.members is list && request.resource.data.members.size() <= 4
        && request.resource.data.status == 'new'
        && request.resource.data.t == request.time;
      allow update: if request.auth != null && request.auth.token.email == 'tenyekat@gmail.com'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow read, delete: if request.auth != null && request.auth.token.email == 'tenyekat@gmail.com';
    }
    // sub_codes/<رقم الجهاز>: رمز التفعيل الذي يكتبه هاتف المشرف؛ يقرؤه التطبيق برقم جهازه (الرمز لا يعمل على هاتف آخر)، ولا يُسرد.
    match /sub_codes/{id} {
      allow get: if true;
      allow list, write: if request.auth != null && request.auth.token.email == 'tenyekat@gmail.com';
    }
    // sub_config/public: السعر وأرقام الدفع ورقم التواصل كما تعرضها شاشة الاشتراك؛ يكتبها المشرف ويقرؤها الجميع.
    match /sub_config/{doc} {
      allow get: if true;
      allow list, write: if request.auth != null && request.auth.token.email == 'tenyekat@gmail.com';
    }
    // sub_trials/<رقم الجهاز>: لحظة أول تشغيل للتطبيق على الهاتف، تُكتب مرة واحدة بوقت الخادم ولا تُغيَّر ولا تُحذف إلا من المشرف؛
    // منها تُحسب التجربة المجانية، فلا تعيدها إعادة التثبيت.
    match /sub_trials/{id} {
      allow get: if true;
      allow create: if id.matches('^[A-Z2-7]{10}$')
        && request.resource.data.keys().hasOnly(['t'])
        && request.resource.data.t == request.time;
      allow list, delete: if request.auth != null && request.auth.token.email == 'tenyekat@gmail.com';
    }
