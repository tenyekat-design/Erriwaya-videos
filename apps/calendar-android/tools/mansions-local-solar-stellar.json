    {
      "id": "thurayya",
      "traditional_order": 3,
      "name_ar": "الثُّرَيَّا",
      "name_plain": "الثريا",
      "name_variants": [
        "النجم"
      ],
      "local_hassaniya_name_verified": null,
      "folklore": [
        {
          "type": "معتقد موسمي",
          "text": "يُشار إلى طلوع الثريا في بعض الروايات الموريتانية باعتباره من أنجام الحر والغبار؛ وترد تسمية «أدموع الثريا» للأمطار المتوقعة أو المفاجئة خلال موسمه.",
          "region": "موريتانيا، ورد في شهادة منشورة دون تحديد دقيق للموقع",
          "source_id": "local_2023",
          "certainty": "local_report"
        },
        {
          "type": "اسم",
          "text": "الثريا عنقود نجمي، وليس نجمًا منفردًا؛ اسم «النجم» هنا اسم عربي عام وليس توثيقًا لاسم حساني خاص ببوتلميت.",
          "source_id": "poem",
          "certainty": "general_astronomy"
        }
      ],
      "stellar_poem": {
        "month_day": "10-18",
        "status": "direct",
        "source_id": "poem",
        "caution": null
      }
    },
    {
      "id": "dabaran",
      "traditional_order": 4,
      "name_ar": "الدَّبَرَان",
      "name_plain": "الدبران",
      "name_variants": [],
      "local_hassaniya_name_verified": null,
      "folklore": [
        {
          "type": "حكاية شعبية",
          "text": "في رواية منشورة يتباهى الدبران على الثريا بشدة «الردم»؛ وهي حكاية تصويرية لشدة الغبار والحر، لا تفسير سببي للطقس.",
          "region": "رواية شعبية موريتانية منشورة",
          "source_id": "local_2023",
          "certainty": "local_report"
        },
        {
          "type": "ممارسة اجتماعية",
          "text": "يذكر المصدر أن المسافرين في البادية كانوا يحتاطون من حر هذه المواسم ويتزودون بالماء في رحلاتهم.",
          "source_id": "local_2023",
          "certainty": "local_report"
        }
      ],
