  "about": "تقويمان مستقلان للأسماء نفسها. لا تُخلط مواقيت الطلوع المروية بحساب موقع الشمس الحقيقي أو الطلوع الفلكي المحسوب.",
  "calendars": {
    "solar_seasons": {
      "display_name": "المنازل الشمسية الموسمية",
      "algorithm": "28 فترات متعاقبة، كل منها 13 يومًا، مع يوم/يومين إداريين لاستكمال 365/366 يومًا في آخر فترة؛ التمديد تصرف حسابي لا نص تراثي.",
      "source_anchor": {
        "date": "2023-06-09",
        "mansion_id": "thurayya",
        "source_id": "local_2023"
      },
      "calendar_anchor_rule": "يُستخدم 9 يونيو من كل سنة كمرساة اصطلاحية مستنتجة من شهادة 2023؛ لا يعني أن هذا ثابت رصديًا أو متفق عليه محليًا كل سنة.",
      "observational_event": false,
      "status": "provisional_traditional_reconstruction"
    },
    "stellar_poem": {
      "display_name": "النجوم والطوالع – حساب المنظومة الشنقيطية",
      "algorithm": "تواريخ شهر/يوم كما في القصيدة المنشورة، مع تمييز ثلاثة تواريخ مستنتجة؛ تتحول إلى جدول سنوي لا إلى حساب الطلوع الحقيقي عند الأفق.",
      "observational_event": false,
      "status": "poetic_historical_table_not_verified_ephemeris",
      "source_id": "poem"
    }
