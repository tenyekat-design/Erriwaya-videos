<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="mr.erriwaya.calendar">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- the heritage wallpapers in the settings (a normal permission, granted on install) -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <!-- a calendar with prayer alarms and a minute clock widget: granted without asking from Android 13 -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".SuggestJob" android:permission="android.permission.BIND_JOB_SERVICE" android:exported="false" />
        <service android:name=".AdhanService" android:exported="false" android:foregroundServiceType="mediaPlayback" />
        <receiver android:name=".AdhanReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
        <receiver android:name=".CalendarWidget" android:exported="true" android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/calendar_widget" />
        </receiver>
        <!-- PUBLISHER-ONLY: build.sh leaves this service out of the public APK (dist/mauritania-calendar.apk) and keeps it in
             dist/mauritania-calendar-publisher.apk. Google Play Protect refuses to install, from a file, any app that declares a
             notification listener, so subscribers' phones must never see it.
             The publisher's phone only: hears the banks' payment notifications once he grants notification access (Pay) -->
        <service android:name=".PayListener" android:exported="true" android:label="التقاط رسائل الدفع (للناشر)"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <!-- /PUBLISHER-ONLY -->
        <!-- each widget's own settings (background, and for the months which names): long-press the widget, then its settings -->
        <!-- a photo behind a widget: picked, cropped to the widget's shape, dimmed (from the widget's settings) -->
        <!-- «إشعار اليوم»: redraws the lock-screen notification at midnight and at each prayer -->
        <receiver android:name=".LockNote" android:exported="false" />
        <!-- two reminders before the free day ends (TrialNote) -->
        <receiver android:name=".TrialNote" android:exported="false" />
        <!-- «الويدجت»: the widgets shown as they look, for all; locked for non-subscribers -->
        <activity android:name=".WidgetShow" android:exported="false" android:label="الويدجت"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />
        <activity android:name=".WidgetPhoto" android:exported="false" android:label="خلفية الويدجت"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" android:excludeFromRecents="true" />
        <!-- the launcher reads the widgets' photos from here (files/wbg only, read-only) -->
        <provider android:name=".WidgetPics" android:authorities="mr.erriwaya.calendar.widgetpics" android:exported="true" />
        <activity android:name=".WidgetConfig" android:exported="true" android:label="إعداد الويدجت"
            android:theme="@android:style/Theme.DeviceDefault.Light.Dialog" android:excludeFromRecents="true">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" /></intent-filter>
        </activity>
        <!-- «الساعة»: digital or with hands, per widget; for the free day and subscribers -->
        <receiver android:name=".ClockWidget" android:exported="true" android:label="@string/clock_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/clock_widget" />
        </receiver>
        <!-- «أشهر السنة»: like the weekday widget, for the free day and subscribers -->
        <receiver android:name=".MonthWidget" android:exported="true" android:label="@string/month_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/month_widget" />
        </receiver>
        <!-- «يوم الأسبوع»: offered to everyone; it shows the day during the free day and for subscribers, and asks to subscribe otherwise -->
        <!-- «آيات من القرآن»: a verse that changes every hour, or on a tap -->
        <receiver android:name=".AyatWidget" android:exported="true" android:label="@string/ayat_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/ayat_widget" />
        </receiver>
        <receiver android:name=".DayWidget" android:exported="true" android:label="@string/day_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/day_widget" />
        </receiver>
    </application>
</manifest>
